# Pricora environment variables. Copy to .env and fill in.
# Secrets MUST stay empty in this file. Local-service defaults below are dev-only.

NODE_ENV=development

# --- Core infrastructure (docker-compose.yml) ---
# Local dev: postgresql://pricora:pricora@localhost:5434/pricora?schema=public
DATABASE_URL=
# Local dev: redis://localhost:6380
REDIS_URL=
# Local dev: http://localhost:7700
MEILI_HOST=
# Any string >= 16 bytes; docker-compose reads the same variable
MEILI_MASTER_KEY=

# --- App ---
# >= 32 random chars (openssl rand -hex 32)
SESSION_SECRET=
WEB_ORIGIN=http://localhost:3100
ADMIN_ORIGIN=http://localhost:3001
API_URL=http://localhost:4400
API_PORT=4400
# Shared secret for trusted server-to-server calls from the web/admin SSR servers (header x-internal-api-key).
# Generate with: openssl rand -hex 32. Web/admin must use the same value (server-side only, never NEXT_PUBLIC_).
INTERNAL_API_KEY=
# Express trust proxy. Leave empty locally (X-Forwarded-For ignored). Prod example: TRUST_PROXY=10.0.0.0/8 or 1
TRUST_PROXY=
# Rate limits (per minute). Auth limit is per client IP; per-account login lockout applies on top.
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=30
# Upload staging dir shared by API + worker (default: OS temp dir/pricora-feeds). Use object storage in production.
FEED_UPLOAD_DIR=
# Local object storage for logos etc. (served at API_URL/static). Default: <repo>/.data/storage
STORAGE_DIR=
# AES-256-GCM key for integration credentials managed in the admin panel (openssl rand -base64 32).
# Required in production. Rotating it makes stored credentials unreadable (re-enter them in admin).
CREDENTIALS_ENCRYPTION_KEY=

# --- Seed ---
# Password for admin@pricora.local and merchant@pricora.local.
# If empty, seed uses the dev default "PricoraDev!2026" (local dev only; never in production).
SEED_ADMIN_PASSWORD=

# --- Retailers ---
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1
WALMART_CONSUMER_ID=
WALMART_PRIVATE_KEY=
WALMART_KEY_VERSION=
WALMART_PUBLISHER_ID=
BESTBUY_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=

# --- Affiliate networks ---
CJ_PERSONAL_ACCESS_TOKEN=
CJ_WEBSITE_ID=
CJ_COMPANY_ID=
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
RAKUTEN_CLIENT_ID=
