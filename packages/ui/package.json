{
  "name": "@pricora/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Pricora shared React (web) components. Tailwind v4 classes, no bundled CSS.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/post-build.mjs",
    "typecheck": "tsc --noEmit",
    "verify:css": "tailwindcss -i scripts/verify.css -o dist/.verify.css"
  },
  "dependencies": {
    "@pricora/design-tokens": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.79.0",
    "radix-ui": "1.8.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
