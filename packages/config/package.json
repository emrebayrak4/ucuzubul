{
  "name": "@pricora/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./brand": {
      "import": { "types": "./dist/brand.d.ts", "default": "./dist/brand.js" },
      "require": { "types": "./dist/brand.d.cts", "default": "./dist/brand.cjs" }
    },
    "./env": {
      "import": { "types": "./dist/env.d.ts", "default": "./dist/env.js" },
      "require": { "types": "./dist/env.d.cts", "default": "./dist/env.cjs" }
    },
    "./tsconfig/*": "./tsconfig/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "tsconfig"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
