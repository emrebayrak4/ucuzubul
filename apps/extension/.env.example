# Build-time settings (Vite). Copy to .env.local to override. No secrets belong here: everything is bundled into the extension.
# Pricora API origin. Must be listed in host_permissions (the build script derives it from this value).
VITE_PRICORA_API_URL=
# Pricora web origin used for "Open on Pricora", search and login links.
VITE_PRICORA_WEB_URL=
