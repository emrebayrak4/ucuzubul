# Server-side API origin (used by Server Components / route handlers)
API_URL=http://localhost:4400
# Browser-side API origin (client mutations, autocomplete)
NEXT_PUBLIC_API_URL=http://localhost:4400
# Public site origin (canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Server-only shared secret for SSR -> API calls (header x-internal-api-key). Must match the API INTERNAL_API_KEY. Never NEXT_PUBLIC_.
INTERNAL_API_KEY=
