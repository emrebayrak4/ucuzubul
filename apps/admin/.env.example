# apps/admin — public API origin (no /v1). Browser calls go here with credentials.
NEXT_PUBLIC_API_URL=http://localhost:4400
# Server-side (RSC auth gate) API origin; defaults to NEXT_PUBLIC_API_URL.
API_URL=
# Server-only shared secret for SSR → API calls (sent as x-internal-api-key with the visitor IP in x-pricora-client-ip).
# Must match the API's INTERNAL_API_KEY. Never prefix with NEXT_PUBLIC_.
INTERNAL_API_KEY=
