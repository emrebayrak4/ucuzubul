# API origin (no /v1). Leave empty to use the dev defaults:
#   Android emulator -> http://10.0.2.2:4400, iOS simulator -> http://localhost:4400,
#   physical device in dev -> http://<metro host LAN IP>:4400
EXPO_PUBLIC_API_URL=
# Web origin used for share links / universal links (default https://pricora.com from @pricora/config brand)
EXPO_PUBLIC_WEB_URL=
# EAS project id (needed for Expo push tokens). Empty until the app is linked with `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=
