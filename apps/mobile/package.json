  "devDependencies": {
    "@types/react": "19.3.1",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "typescript"
      ]
    }
  }
