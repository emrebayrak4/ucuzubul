{
  "name": "@pricora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./core": "./src/core/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "logos:fetch": "tsx src/scripts/fetch-logos.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.6.1",
    "@nestjs/core": "12.6.1",
    "@nestjs/platform-express": "12.6.1",
    "@nestjs/throttler": "6.8.0",
    "@node-rs/argon2": "2.2.2",
    "@pricora/algorithms": "workspace:*",
    "@pricora/config": "workspace:*",
    "@pricora/contracts": "workspace:*",
    "@pricora/database": "workspace:*",
    "@pricora/retailer-adapters": "workspace:*",
    "@pricora/utils": "workspace:*",
    "bullmq": "6.7.10",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.1.0",
    "meilisearch": "0.63.0",
    "multer": "2.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7",
    "@pricora/content": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.4",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "supertest": "7.3.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
